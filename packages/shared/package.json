{
  "name": "@saga/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-cutting Saga primitives: errors, logging, config, time, redaction.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  }
}
