{
  "name": "@saga/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod request/response contracts and OpenAPI generation for Saga.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@saga/shared": "workspace:*",
    "zod": "^3.24.1"
  }
}
