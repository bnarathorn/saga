# ---------------------------------------------------------------------------
# Saga environment. Copy to `.env` and adjust. No real secrets belong in here.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
SAGA_VERSION=0.1.0
LOG_LEVEL=info

# --- API server ------------------------------------------------------------
# Bind to loopback when nginx terminates TLS in front of the API.
SAGA_API_HOST=127.0.0.1
SAGA_API_PORT=4319
# Public origin of Guild Hall. Used for cookie/CORS decisions and device-flow URLs.
SAGA_PUBLIC_URL=http://localhost:4320
# Comma-separated extra allowed origins. Empty means same-origin only.
SAGA_CORS_ORIGINS=
# Maximum accepted request body, in bytes.
SAGA_MAX_BODY_BYTES=1048576
# Where the API finds the CLI bundle it serves at /api/cli/saga. Leave unset: the route resolves
# it from its own compiled location, which is correct for both the container image and a systemd
# deployment. Set it only for a layout that keeps the build output somewhere else entirely.
# SAGA_CLI_ARTIFACT_DIR=

# --- Guild Hall (web) ------------------------------------------------------
SAGA_WEB_PORT=4320

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://saga:saga@127.0.0.1:5432/saga_dev
SAGA_TEST_DATABASE_URL=postgres://saga:saga@127.0.0.1:5432/saga_test
# A second database, because the e2e stack empties its own before the API starts. Leaving this
# unset falls back to SAGA_TEST_DATABASE_URL (tests/e2e/stack-env.ts), which means `pnpm test:e2e`
# wipes the fixtures the integration and api suites are using.
SAGA_E2E_DATABASE_URL=postgres://saga:saga@127.0.0.1:5432/saga_e2e
# Ports the e2e stack listens on. Offset from the development ports so a running `pnpm dev` and
# a `pnpm test:e2e` do not fight over the same two.
SAGA_E2E_API_PORT=4419
SAGA_E2E_WEB_PORT=4420
SAGA_DB_POOL_MAX=10
SAGA_DB_STATEMENT_TIMEOUT_MS=15000

# --- Security --------------------------------------------------------------
# 32+ byte random string. Generate with: openssl rand -hex 32
SAGA_SESSION_SECRET=change-me-development-only-session-secret-value
SAGA_SESSION_TTL_HOURS=12
SAGA_COOKIE_SECURE=false
# Never enable in production. The process refuses to start if NODE_ENV=production.
SAGA_DEV_AUTH_BYPASS=false
# Optional bootstrap administrator, created by the API process on startup
# (before it starts listening) if no user yet exists. Remove the password after first sign-in.
SAGA_BOOTSTRAP_ADMIN_EMAIL=admin@saga.local
SAGA_BOOTSTRAP_ADMIN_PASSWORD=
# Agent token presented by CI / non-interactive integrations.
SAGA_TOKEN=
# Per-minute rate limits, counted per client. Sign-in and device-flow are deliberately far
# tighter than the general API, because they are the two endpoints worth guessing at.
SAGA_LOGIN_RATE_LIMIT_PER_MINUTE=10
SAGA_DEVICE_RATE_LIMIT_PER_MINUTE=20
SAGA_API_RATE_LIMIT_PER_MINUTE=300

# --- Worker ----------------------------------------------------------------
SAGA_WORKER_CONCURRENCY=2
SAGA_WORKER_POLL_INTERVAL_MS=1000
SAGA_JOB_LEASE_SECONDS=60
SAGA_JOB_MAX_ATTEMPTS=5
SAGA_SERVICE_LEASE_SECONDS=30
SAGA_HEARTBEAT_INTERVAL_MS=10000

# --- Embeddings ------------------------------------------------------------
# fake | ollama
SAGA_EMBEDDING_PROVIDER=fake
SAGA_EMBEDDING_DIMENSIONS=768
SAGA_EMBEDDING_MODEL=nomic-embed-text
SAGA_OLLAMA_URL=http://127.0.0.1:11434
SAGA_EMBEDDING_TIMEOUT_MS=30000

# --- Relation inference ----------------------------------------------------
# The model that proposes relations between Lore Entries, separate from the embedding model
# because nomic-embed-text cannot answer a question. `fake` proposes nothing, so the job runs
# its deterministic half alone and no model server is needed. Ollama URL is shared above.
# fake | ollama
SAGA_INFERENCE_PROVIDER=fake
SAGA_INFERENCE_MODEL=qwen2.5:7b-instruct
SAGA_INFERENCE_TIMEOUT_MS=60000
SAGA_INFERENCE_MAX_CANDIDATES=5
SAGA_INFERENCE_MIN_CONFIDENCE=0.6

# --- Party -----------------------------------------------------------------
# off | advisory | strict
PARTY_MODE=advisory
SAGA_AGENT_RUN_LEASE_SECONDS=90
SAGA_CLAIM_LEASE_SECONDS=90
SAGA_SESSION_ABANDON_AFTER_MINUTES=180

# --- Context budgets (tokens) ---------------------------------------------
SAGA_CORE_CONTEXT_TOKENS=3500
SAGA_TASK_CONTEXT_TOKENS=4000
SAGA_CONTINUATION_CONTEXT_TOKENS=2500
SAGA_PARTY_CONTEXT_TOKENS=1000

# --- Retention -------------------------------------------------------------
SAGA_JOB_RETENTION_DAYS=14
SAGA_SYSTEM_EVENT_RETENTION_DAYS=30
SAGA_IDEMPOTENCY_RETENTION_HOURS=24
