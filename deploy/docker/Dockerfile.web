# Guild Hall is served as static files by nginx, deliberately independent of the API process:
# when the API is down the console still loads and reports that the API is unreachable.

FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec tsc -b tsconfig.build.json && pnpm --filter @saga/web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY deploy/nginx/guild-hall.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
