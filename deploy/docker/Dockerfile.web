# Guild Hall is served as static files by nginx, deliberately independent of the API process:
# when the API is down the console still loads and reports that the API is unreachable.

FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec tsc -b tsconfig.build.json && pnpm --filter @saga/web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
# compose.conf, not guild-hall.conf: the latter is written for a host deployment — TLS with a real
# certificate, and an API on 127.0.0.1 — none of which exists in this image. Both files include
# saga-headers.conf, which must be copied alongside or nginx refuses to start.
COPY deploy/nginx/compose.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/saga-headers.conf /etc/nginx/saga-headers.conf
EXPOSE 80
