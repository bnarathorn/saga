# /etc/saga/saga.env — owned by root:saga, mode 0640. Never world-readable.
#
# systemd reads this file directly; values are NOT shell-expanded, so no quoting is needed
# and `$` is literal.

NODE_ENV=production
SAGA_VERSION=0.1.0
LOG_LEVEL=info

# The API binds loopback because nginx terminates TLS in front of it.
SAGA_API_HOST=127.0.0.1
SAGA_API_PORT=4319
SAGA_PUBLIC_URL=https://saga.example.internal
SAGA_COOKIE_SECURE=true

# Generate with: openssl rand -hex 32
SAGA_SESSION_SECRET=replace-me

DATABASE_URL=postgres://saga:replace-me@127.0.0.1:5432/saga

# The first administrator, created before the port opens. There is no signup page and no default
# account, so both of these must be non-empty on the first start or nobody can sign in. Delete the
# password line once you have signed in, then restart saga-api — the account is in the database and
# does not need it again.
SAGA_BOOTSTRAP_ADMIN_EMAIL=admin@saga.local
# Generate with: openssl rand -hex 12
SAGA_BOOTSTRAP_ADMIN_PASSWORD=replace-me

# Ollama is not installed by any of this. Pull the model first — `ollama pull nomic-embed-text` —
# and keep the width at 768: the embedding column is vector(768), and a model of any other size
# dead-letters every embedding job while Lore keeps publishing text-only.
SAGA_EMBEDDING_PROVIDER=ollama
SAGA_OLLAMA_URL=http://127.0.0.1:11434
SAGA_EMBEDDING_MODEL=nomic-embed-text
SAGA_EMBEDDING_DIMENSIONS=768

PARTY_MODE=advisory
SAGA_WORKER_CONCURRENCY=2

# Must remain false. The process refuses to start in production if this is true.
SAGA_DEV_AUTH_BYPASS=false
