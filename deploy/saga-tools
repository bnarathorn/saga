#!/usr/bin/env bash
#
# saga-tools — server-side maintenance for a systemd Saga install.
#
#   saga-tools update [--force]   fetch the published branch and deploy it
#   saga-tools rebuild            rebuild and restart whatever is checked out
#   saga-tools status             what is deployed, what is available, what is running
#
# `update` tracks the public repository directly: the service account needs no
# credentials to fetch it, so the deploy host pulls its own updates instead of
# waiting for someone to push a build across from a developer checkout. There is no
# second script and no second way — a commit reaches production by being on the
# published branch.
#
# `rebuild` is the same build without the fetch: the second half of a rollback, and
# the way to recover a tree whose build did not finish. It touches the network only
# to verify the result, so it still works when the remote does not. `update` runs it
# out of the target after fast-forwarding whenever the fetched copy of this script
# differs from the running one, so an upgrade can change the upgrade procedure — and
# then tells you to reinstall, because /usr/local/bin still holds the old copy.
#
# Install it as root:
#
#   install -m 755 /opt/saga/deploy/saga-tools /usr/local/bin/saga-tools
#
# Run it as a user that may sudo. Every override below is an environment variable:
#
set -euo pipefail

TARGET=${SAGA_TARGET:-/opt/saga}
SERVICE_USER=${SAGA_SERVICE_USER:-saga}
REMOTE=${SAGA_REMOTE:-https://github.com/bnarathorn/saga.git}
BRANCH=${SAGA_BRANCH:-main}
ORIGIN=${SAGA_ORIGIN:-http://127.0.0.1:4319}
WEB_ROOT=${SAGA_WEB_ROOT:-/var/www/saga-app}
WEB_OWNER=${SAGA_WEB_OWNER:-www-data:www-data}
# The service account's home is the deploy directory, so anything it runs needs a
# writable home elsewhere or it litters the checkout with `.cache/` and `.npm/`.
# Kept across runs so corepack does not re-download pnpm every deploy.
BUILD_HOME=${SAGA_BUILD_HOME:-/var/tmp/saga-build-home}

say() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# GIT_TERMINAL_PROMPT=0 turns a credential prompt into an immediate failure. The
# repository is public and none should ever appear; if one does, the cause is a
# misconfigured remote, and hanging forever on a server is the worst way to say so.
as_service() { sudo -u "$SERVICE_USER" env HOME="$BUILD_HOME" GIT_TERMINAL_PROMPT=0 "$@"; }
target_git() { as_service git -C "$TARGET" "$@"; }

served_build() {
  curl -fsS -k "$ORIGIN/api/cli/saga" 2>/dev/null | grep -ao '0\.1\.0+g[a-z0-9.]*' | head -1 || true
}

usage() {
  cat <<'USAGE'
saga-tools — server-side maintenance for a systemd Saga install.

  saga-tools update [--force]   Fetch the published branch and deploy it.
                                --force rebuilds even when already up to date.
  saga-tools rebuild            Rebuild and restart what is already checked out,
                                moving no commits. The second half of a rollback.
  saga-tools status             Show the deployed commit, whether the remote is
                                ahead, the CLI build being served, and unit state.

Environment: SAGA_TARGET, SAGA_SERVICE_USER, SAGA_REMOTE, SAGA_BRANCH,
             SAGA_ORIGIN, SAGA_WEB_ROOT, SAGA_WEB_OWNER, SAGA_BUILD_HOME.
USAGE
}

preflight() {
  [ -d "$TARGET/.git" ] || die "$TARGET is not a git checkout"
  command -v rsync >/dev/null || die "rsync is required"
  sudo -n true 2>/dev/null || sudo true || die "saga-tools needs sudo"
  sudo install -d -o "$SERVICE_USER" -m 755 "$BUILD_HOME"
}

# The remote is a deployment detail, not something a checkout is trusted to have
# right: a tree copied from elsewhere can name a URL nobody here can reach.
ensure_remote() {
  local current
  current=$(target_git remote get-url origin 2>/dev/null || true)
  if [ -z "$current" ]; then
    target_git remote add origin "$REMOTE"
  elif [ "$current" != "$REMOTE" ]; then
    say "Pointing origin at $REMOTE (was $current)"
    target_git remote set-url origin "$REMOTE"
  fi
}

# A dirty production tree means someone edited the server in place. Refuse rather
# than silently discarding it: a fast-forward would fail halfway through anyway, and
# a build from a tree nobody can name is worse than no build.
assert_clean() {
  if [ -n "$(target_git status --porcelain --untracked-files=no)" ]; then
    target_git status --short --untracked-files=no
    die "$TARGET has uncommitted tracked changes — resolve them before deploying"
  fi
}

# Build, publish, restart and verify whatever is checked out. Shared by `update` and
# `rebuild` so the two cannot drift, and read from the tree just fetched so an update
# also picks up changes to the deploy procedure itself.
deploy_checkout() {
  say "Installing dependencies"
  as_service pnpm -C "$TARGET" install --frozen-lockfile

  # `build` is tsc -b + the web bundle + the CLI bundle. The CLI bundle stamps itself
  # with the commit it was built from, which is what the verification below reads.
  say "Building"
  as_service pnpm -C "$TARGET" build

  say "Publishing $WEB_ROOT"
  sudo rsync -a --delete "$TARGET/apps/web/dist/" "$WEB_ROOT/"
  sudo chown -R "$WEB_OWNER" "$WEB_ROOT"

  # Migrations first: the new server code may depend on the new schema, and
  # saga-migrate is a one-shot that runs them under the production environment file.
  say "Restarting services"
  sudo systemctl restart saga-migrate
  sudo systemctl restart saga-api saga-worker

  say "Verifying"
  sudo systemctl is-active saga-api saga-worker
  local short served
  short=$(target_git rev-parse --short=10 HEAD)
  # `systemctl restart` returns once the process exists, not once it is listening, so
  # the first request after it can still be nginx's 502. Poll rather than conclude.
  served=
  for _ in $(seq 30); do
    served=$(served_build)
    [ -n "$served" ] && break
    sleep 1
  done
  printf '  served CLI build: %s\n' "${served:-<unreadable>}"
  case "$served" in
    *"g$short"*) ;;
    *) die "the API is not serving a CLI built from $short — check: journalctl -u saga-api -n 50" ;;
  esac
}

cmd_status() {
  preflight
  ensure_remote
  local head subject remote_head behind served
  head=$(target_git rev-parse HEAD)
  subject=$(target_git log -1 --format='%s')
  target_git fetch --quiet origin "$BRANCH" || die "cannot reach $REMOTE"
  remote_head=$(target_git rev-parse FETCH_HEAD)
  behind=$(target_git rev-list --count "HEAD..$remote_head")

  printf 'deployed  %s  %s\n' "${head:0:10}" "$subject"
  if [ "$head" = "$remote_head" ]; then
    printf 'remote    up to date (%s %s)\n' "$REMOTE" "$BRANCH"
  else
    printf 'remote    %s ahead by %s commit(s) — run: saga-tools update\n' "${remote_head:0:10}" "$behind"
  fi

  served=$(served_build)
  printf 'serving   %s\n' "${served:-<the API did not answer>}"
  # A served build whose commit is not the deployed one means the tree moved and
  # nothing rebuilt — the exact state a half-finished deploy leaves behind.
  case "$served" in
    '' | *"g${head:0:10}"*) ;;
    *) printf '          \033[33mwarning:\033[0m that build is not %s — rerun: saga-tools rebuild\n' "${head:0:10}" ;;
  esac

  printf 'units     '
  sudo systemctl is-active saga-api saga-worker | paste -sd' ' -
}

cmd_rebuild() {
  preflight
  assert_clean
  local head
  head=$(target_git rev-parse HEAD)
  say "Building $TARGET at $head"
  deploy_checkout
  say "Deployed $head"

  # Set by `update` when it hands off after a fast-forward, so the rollback hint names the
  # commit that was actually replaced rather than the one just built.
  if [ -n "${SAGA_PREVIOUS_COMMIT:-}" ]; then
    # Going backwards is not a fast-forward, so a rollback resets the branch and then rebuilds
    # it in place; the old objects are still in the target's object store.
    printf 'Roll back with:\n  sudo -u %s git -C %s reset --hard %s\n  saga-tools rebuild\n' \
      "$SERVICE_USER" "$TARGET" "$SAGA_PREVIOUS_COMMIT"
  fi

  # `update` re-execs the fetched copy, so this can be the newer script running while
  # /usr/local/bin still holds the old one. Say so once rather than let the next run surprise.
  if [ -n "${SAGA_HANDED_OFF:-}" ]; then
    printf '\nThis deploy changed saga-tools itself. Install the new one:\n  sudo install -m 755 %s/deploy/saga-tools /usr/local/bin/saga-tools\n' "$TARGET"
  fi
}

cmd_update() {
  local force=${1:-}
  preflight
  ensure_remote

  say "Fetching $BRANCH from $REMOTE"
  target_git fetch origin "$BRANCH" || die "cannot reach $REMOTE"
  local old new
  old=$(target_git rev-parse HEAD)
  new=$(target_git rev-parse FETCH_HEAD)
  printf '  deployed: %s\n  available: %s\n' "$old" "$new"

  if [ "$old" = "$new" ] && [ "$force" != "--force" ]; then
    say "Already at $new — nothing to do (pass --force to rebuild anyway)"
    exit 0
  fi

  assert_clean

  if [ "$old" != "$new" ]; then
    # Refuse a rewritten remote rather than resolving it: discarding the deployed
    # commit is a decision for whoever rewrote the history, not for this script.
    target_git merge-base --is-ancestor "$old" "$new" ||
      die "$BRANCH is not a fast-forward from $old — the remote history was rewritten. Deliberately discard the deployed commit with:
  sudo -u $SERVICE_USER git -C $TARGET reset --hard $new
then rerun: saga-tools update --force"
    say "Fast-forwarding $TARGET to $new"
    target_git merge --ff-only FETCH_HEAD
  fi

  # The tree just fetched may carry a newer version of this script, and the build half must
  # come from there rather than from whatever `/usr/local/bin` happens to hold — that is what
  # makes an upgrade able to change the upgrade procedure itself. Hand over when the two
  # differ. A `cmp` that cannot read either file also hands over, which is the safe direction.
  # A rollback hint is only meaningful when a commit actually moved. `--force` on an unchanged
  # tree rebuilds the commit it is already on, and naming it as the thing to go back to is noise.
  if [ "$old" != "$new" ]; then
    export SAGA_PREVIOUS_COMMIT="$old"
  fi

  # The tree just fetched may carry a newer version of this script, and the build half must come
  # from there rather than from whatever `/usr/local/bin` happens to hold — that is what makes an
  # upgrade able to change the upgrade procedure itself. Hand over when the two differ; a `cmp`
  # that cannot read either file also hands over, which is the safe direction.
  say "Building and restarting"
  if ! cmp -s "$0" "$TARGET/deploy/saga-tools"; then
    say "Handing off to the saga-tools in $TARGET"
    export SAGA_HANDED_OFF=1
    exec bash "$TARGET/deploy/saga-tools" rebuild
  fi

  cmd_rebuild
}

case "${1:-}" in
  update) shift; cmd_update "${1:-}" ;;
  rebuild) cmd_rebuild ;;
  status) cmd_status ;;
  -h | --help | help | '') usage ;;
  *) usage >&2; die "unknown command: $1" ;;
esac
