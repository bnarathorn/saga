{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@saga/contracts": ["../../packages/contracts/src/index.ts"],
      "@saga/contracts/*": ["../../packages/contracts/src/*"],
      "@saga/shared": ["../../packages/shared/src/index.ts"],
      "@saga/shared/*": ["../../packages/shared/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "e2e/**/*.ts"]
}
